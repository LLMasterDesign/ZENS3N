{
  "name": "Agent",
  "type": "object",
  "properties": {
    "name":   { "type": "string", "description": "Display name, e.g. Ender" },
    "handle": { "type": "string", "description": "Telegram/bot handle, e.g. @ender_zenbot" },
    "kind":   { "type": "string", "description": "What it is — warden, relay, sidekik…" },
    "node":   { "type": "string", "description": "Where it runs, e.g. en0" },
    "status": { "type": "string", "description": "connected · idle · offline" },
    "glyph":  { "type": "string", "description": "Its mark, e.g. ▛▞" }
  },
  "required": ["name"]
}
