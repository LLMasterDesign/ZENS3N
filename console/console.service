[Unit]
Description=CONSOLE · minsky · planes + health · tailnet only
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/zens3n/console
ExecStart=/usr/bin/python3 /srv/zens3n/console/console.py
Environment=PORT=6050
Environment=BIND=100.85.222.9
Restart=always
RestartSec=5
User=www-data
Group=www-data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/zens3n-data
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=64M

[Install]
WantedBy=multi-user.target
